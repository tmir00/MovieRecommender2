# Copy to `.env` in this directory:  cp .env.example .env
# Recommender API (search + catalog writes). Not committed.

DATABASE_URL=postgresql+psycopg://movierec:movierec@postgres:5432/movierec
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX_MOVIES=movies
RECOMMENDER_API_HOST=0.0.0.0
RECOMMENDER_API_PORT=8000
PIPELINE_VERSION=v4
CATALOG_INDEXER_URL=http://catalog-indexer-api:8101
EMBEDDER_URL=http://embedder:8100
EMBEDDING_DIMENSION=384

# Vector similarity search tuning (GET /search/similar)
SIMILAR_MIN_VOTE_COUNT=50
SIMILAR_KNN_CANDIDATES=50
SIMILAR_POPULARITY_FACTOR=0.05
SIMILAR_VOTE_AVERAGE_FACTOR=0.1
