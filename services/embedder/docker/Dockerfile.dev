# Dev image for the sentence-transformer embedder API.
# Build context: ./services (see docker-compose.yml).

FROM python:3.12-slim-bookworm

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

COPY embedder/requirements.txt ./embedder/
RUN pip install --no-cache-dir -r embedder/requirements.txt

COPY embedder/src/ ./embedder/src/

WORKDIR /app/embedder

CMD ["python", "src/main.py"]
