# Copy to `.env` in this directory:  cp .env.example .env
# Movie catalog indexing (index-catalog service). Not committed.

OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX_MOVIES=movies
INDEX_VERSION=v2
MOVIES_CSV_PATH=/data/ml-25m/movies.csv
OPENSEARCH_BULK_CHUNK_SIZE=1000
RECREATE_INDEX=false
PIPELINE_VERSION=v2
MAX_MOVIES=0
LOG_EVERY_N_DOCS=5000
LOGGER_NAME=movie-indexer
LOG_LEVEL=INFO
LOG_FORMAT=json

# Required for index-sync job (Postgres catalog_movies)
DATABASE_URL=postgresql+psycopg://movierec:movierec@postgres:5432/movierec
SYNC_BATCH_SIZE=500

# Live catalog indexer API (catalog-indexer-api service)
CATALOG_INDEXER_HOST=0.0.0.0
CATALOG_INDEXER_PORT=8101

# Embedder service (sentence-transformers)
EMBEDDER_URL=http://embedder:8100
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBED_BATCH_SIZE=32
