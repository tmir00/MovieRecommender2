# Per-stream env files (copy examples before first run):
#   cp .env.ratings.example .env.ratings
#   cp .env.tags.example .env.tags
#
# Docker Compose profiles:
#   docker compose --profile stream up --build   # kafka + both producers
#   docker compose --profile ratings up --build  # kafka + ratings only
#   docker compose --profile tags up --build     # kafka + tags only
