# Copy to `.env` in this directory:  cp .env.example .env
# Producer app settings (loaded into the producer container). Not committed.

# Inside Docker network — use the kafka service name
# From host (local Python): localhost:9094  (see root .env KAFKA_HOST_PORT)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

KAFKA_TOPIC=ratings
RATINGS_CSV_PATH=/data/ml-25m/ratings.csv

# Delay between events in seconds (use 0 for full 25M replay)
STREAM_DELAY_SECONDS=0.05

# Max events to send; 0 = no limit
MAX_EVENTS=10000

# Progress log frequency
LOG_EVERY_N_EVENTS=100000

# Logging: pretty | json
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rows per pandas read_csv chunk (when using chunked reads)
CSV_CHUNK_SIZE=100000
