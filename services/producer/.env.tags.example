# Copy to `.env.tags`:  cp .env.tags.example .env.tags
# Tags stream (producer-tags service). Not committed.

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
DATASET_TYPE=tags
KAFKA_TOPIC=tags
CSV_PATH=/data/ml-25m/tags.csv
LOGGER_NAME=tags-producer

STREAM_DELAY_SECONDS=0.05
MAX_EVENTS=5000
LOG_EVERY_N_EVENTS=500
LOG_LEVEL=INFO
LOG_FORMAT=json
CSV_CHUNK_SIZE=100000
