# Dev image for the rating-event producer (Python only).
# Kafka runs as the separate `kafka` service in docker-compose.yml at the repo root.

FROM python:3.12-slim-bookworm

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/

CMD ["python", "src/producer.py"]
