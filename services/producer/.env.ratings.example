# Copy to `.env.ratings`:  cp .env.ratings.example .env.ratings
# Ratings stream (producer-ratings service). Not committed.

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
DATASET_TYPE=ratings
KAFKA_TOPIC=ratings
CSV_PATH=/data/ml-25m/ratings.csv
LOGGER_NAME=ratings-producer

STREAM_DELAY_SECONDS=0.05
MAX_EVENTS=10000
LOG_EVERY_N_EVENTS=1000
LOG_LEVEL=INFO
LOG_FORMAT=json
CSV_CHUNK_SIZE=100000
