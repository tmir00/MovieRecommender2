# Per-stream env files (copy examples before first run):
#   cp .env.ratings.example .env.ratings
#   cp .env.tags.example .env.tags
#
# Docker Compose profiles:
#   docker compose --profile stream up --build   # kafka + postgres + migrate + producers + consumers
#   docker compose --profile ratings up --build  # ratings producer + consumer (+ migrate)
#   docker compose --profile tags up --build     # tags producer + consumer (+ migrate)
#
# Health probes (optional overrides; defaults shown):
#   HEALTH_PORT=8080
#   HEALTH_MAX_POLL_AGE_SECONDS=90
#
# Kubernetes probe mapping (port HEALTH_PORT, default 8080):
#   startupProbe  -> GET /health/startup   (live + Postgres; tolerant during group join)
#   readinessProbe -> GET /health/ready    (+ Kafka partition assignment)
#   livenessProbe -> GET /health/live      (poll loop only; restarts wedged workers)
#
# Docker Compose uses /health/live only; start_period gives boot grace time.
