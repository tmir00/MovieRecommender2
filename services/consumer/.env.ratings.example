# Copy to `.env.ratings`:  cp .env.ratings.example .env.ratings
# Ratings stream (consumer-ratings service). Postgres creds from repo root `.env`.

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
DATASET_TYPE=ratings
KAFKA_TOPIC=ratings
KAFKA_GROUP_ID=movierec-ratings-consumer
LOGGER_NAME=ratings-consumer

PIPELINE_VERSION=v1
MAX_EVENTS=0
LOG_EVERY_N_EVENTS=1000
LOG_LEVEL=INFO
LOG_FORMAT=json
