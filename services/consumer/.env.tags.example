# Copy to `.env.tags`:  cp .env.tags.example .env.tags
# Tags stream (consumer-tags service). Postgres creds from repo root `.env`.

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
DATASET_TYPE=tags
KAFKA_TOPIC=tags
KAFKA_GROUP_ID=movierec-tags-consumer
LOGGER_NAME=tags-consumer

PIPELINE_VERSION=v1
MAX_EVENTS=0
LOG_EVERY_N_EVENTS=500
LOG_LEVEL=INFO
LOG_FORMAT=json
