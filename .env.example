# Copy to `.env` at the repo root:  cp .env.example .env
# Shared / infrastructure (Kafka broker, Postgres, OpenSearch, host ports). Not committed.

# Host port mapped to Kafka's PLAINTEXT_HOST listener (clients on your machine)
KAFKA_HOST_PORT=9094

# Postgres (service name `postgres` on the movierec network)
POSTGRES_USER=movierec
POSTGRES_PASSWORD=movierec
POSTGRES_DB=movierec
POSTGRES_HOST_PORT=5432

# OpenSearch (service name `opensearch` on the movierec network; HTTP from host)
OPENSEARCH_HOST_PORT=9200
# JVM heap for the OpenSearch container (adjust if indexing large batches)
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
# Local dev only — set false and set OPENSEARCH_INITIAL_ADMIN_PASSWORD if you enable security
OPENSEARCH_DISABLE_SECURITY_PLUGIN=true
# In-container URL for indexer/API: http://opensearch:9200
# Catalog indexing: services/indexing/.env.example (profile: catalog)
# Recommender API: services/recommender-api/.env.example (profile: api)
RECOMMENDER_API_HOST_PORT=8000

# KRaft single-node broker (apache/kafka image)
CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093,PLAINTEXT_HOST://0.0.0.0:9094
# PLAINTEXT_HOST must use the same host port as KAFKA_HOST_PORT above
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092,PLAINTEXT_HOST://localhost:9094
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
